#!/usr/bin/env bash
# scripts/notify — one-shot Bark push (iPhone) for mission events. A silent no-op
# unless BOTH the Bark URL is configured (~/.miss-claude/bark.env, see below) AND
# this mission opted in (mission.json `"notifications": true` — the dashboard's
# 🔔 toggle). Never fails the caller: hooks run it on every event, so every exit
# path is 0 and all output is discarded.
#
#   Usage: notify <input|done|fail> [body text]
#
# Wired as $MISSION_NOTIFY by the console session scripts and called from the
# mission-console hook files (console-hooks*.settings.json):
#   Notification hook -> `notify input`  (Claude waits for a permission/answer)
#   Stop hook         -> `notify done`   (Claude finished, nothing left running)
# `fail` is for anything that wants to report a failure by hand.
# The hook's stdin JSON can veto the push (see below) and supplies the body when
# no body argument is given.
#
# Config (the ONE place the Bark key lives), a shell fragment:
#   ~/.miss-claude/bark.env   (override path with $MISS_BARK_CONFIG)
#     BARK_URL="https://api.day.app/<your-device-key>"
#     BARK_SOUND="bell"       # optional: a Bark alert sound name; empty/unset
#                             # = Bark's default
#     BARK_OPEN_BASE="https://dashboard.example.net:4200"
#                             # optional: dashboard base URL as the PHONE reaches
#                             # it; tapping a push then opens /m/<mission>/chat
#
# The push TITLE uses the name the dashboard shows (mission.json `title`, else the
# folder); the tap URL keeps the folder name, which is what /m/<name> resolves.

event="${1:-}"; shift 2>/dev/null || true
msg="$*"

conf="${MISS_BARK_CONFIG:-$HOME/.miss-claude/bark.env}"
BARK_URL=""
BARK_SOUND=""
BARK_OPEN_BASE=""
[ -r "$conf" ] && . "$conf" >/dev/null 2>&1
[ -n "$BARK_URL" ] || exit 0

# Per-mission opt-in: mission.json must say exactly `"notifications": true`
# (same test app.py's notifications_enabled() applies). Anything else — no
# mission env, no file, malformed JSON, any other value — means OFF. The same
# read reports the 🔊 toggle (`"notify_sound": false` = deliver silently) and the
# display name: an auto-named mission shows mission.json's `title` while its
# console still runs in the old-named folder (app.py mission_title), and
# $MISSION_NAME is fixed at console launch, so only this read is current.
mj="${MISSION_DATA_DIR:-}/mission.json"
[ -n "${MISSION_DATA_DIR:-}" ] && [ -f "$mj" ] || exit 0
read_meta=$(python3 -c 'import json, sys
try:
    m = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
if m.get("notifications") is not True:
    sys.exit(1)
t = m.get("title")
t = " ".join(t.split()) if isinstance(t, str) else ""
print("silent" if m.get("notify_sound") is False else "sound")
print(t)' "$mj" 2>/dev/null) || exit 0
{ read -r mode; read -r title_meta; } <<< "$read_meta"
[ -n "$mode" ] || exit 0
[ "$mode" = "silent" ] && BARK_SOUND="silence"

name="${title_meta:-${MISSION_NAME:-mission}}"
case "$event" in
  input) title="⏸ $name needs input" ;;
  done)  title="✅ $name finished" ;;
  fail)  title="❌ $name failed" ;;
  *)     title="$name" ;;
esac

# Hooks pipe their JSON payload on stdin. Two kinds of event are not "done or
# needs input" and send nothing:
# - a Stop while background tasks still run: a subagent or background shell
#   finishing wakes Claude for another turn, and every such turn ends in a Stop.
#   The Stop payload's `background_tasks` lists what is still live; the push
#   waits for the Stop that has none (Claude is woken again when each ends).
# - the 60s idle_prompt Notification: it repeats the Stop push, and fires
#   between those wake-ups too. Permission/question prompts still push.
# No body given -> the payload's "message" (e.g. "Claude needs your permission").
if [ ! -t 0 ]; then
  parsed=$(python3 -c 'import json, sys
try:
    p = json.load(sys.stdin)
except Exception:
    p = None
p = p if isinstance(p, dict) else {}
live = [t for t in p.get("background_tasks") or []
        if isinstance(t, dict)
        and t.get("status") not in ("completed", "failed", "killed", "stopped")]
skip = (sys.argv[1] == "done" and live) or \
       (sys.argv[1] == "input" and p.get("notification_type") == "idle_prompt")
print(("skip" if skip else "send") + ":" + " ".join(str(p.get("message") or "").split()))' \
    "$event" 2>/dev/null)
  [ "${parsed%%:*}" = "skip" ] && exit 0
  [ -z "$msg" ] && [ "${parsed%%:*}" = "send" ] && msg="${parsed#*:}"
fi

extra_args=()
[ -n "$BARK_SOUND" ] && extra_args+=(--data-urlencode "sound=$BARK_SOUND")
# Tap-to-open: land on the mission's chat view (needs the base URL the phone uses).
[ -n "$BARK_OPEN_BASE" ] && [ -n "${MISSION_NAME:-}" ] && \
  extra_args+=(--data-urlencode "url=$BARK_OPEN_BASE/m/$MISSION_NAME/chat")
curl -fsS -m 5 -o /dev/null \
  --data-urlencode "title=$title" \
  --data-urlencode "body=${msg:-mission $name}" \
  --data-urlencode "group=miss-claude" \
  "${extra_args[@]}" \
  "$BARK_URL" >/dev/null 2>&1 || true
exit 0
